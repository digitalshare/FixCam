# --- Claude (required): vision + reasoning
ANTHROPIC_API_KEY=
# FIXCAM_CLAUDE_MODEL=claude-opus-5-5
# FIXCAM_CLAUDE_EFFORT=medium

# --- Chert (iMessage)
CHERT_SIGNING_SECRET=
CHERT_TENANT_SLUG=
# Secret returned when you create the webhook subscription (leave empty to skip verification locally)
CHERT_WEBHOOK_SECRET=
# Voice-note replies need a voice-note-enabled line id (GET /api/v1/phone-numbers)
CHERT_PHONE_LINE_ID=

# --- Keenable (web search); keyless public endpoint is used if empty/invalid
KEENABLE_API_KEY=

# --- Speech: any OpenAI-compatible STT/TTS endpoint (optional)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# FIXCAM_STT_MODEL=whisper-1
# FIXCAM_TTS_MODEL=gpt-4o-mini-tts
# FIXCAM_TTS_VOICE=alloy

# Public URL of this server (ngrok/cloudflared) for image links
FIXCAM_PUBLIC_BASE_URL=http://localhost:8000
